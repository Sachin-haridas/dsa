class Solution {
public:
    int search(vector<int>& nums, int target) {
        int l=0;
        int high=nums.size()-1;
        while(l<=high){
            int mid=l+(high-l)/2;
            if(nums[mid]==target) return mid;
            if(nums[mid]>target){
                high=mid-1;

            }
            else{
                l=mid+1;
            }
        }
        return -1;
    }
};
