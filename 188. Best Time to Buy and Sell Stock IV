class Solution {
public:
    int soln(int i,int state, int k , vector<vector<vector<int>>> &dp, vector<int>& prices){
        if(k==0 || i==prices.size()){
            if(state==1) return INT_MIN/2;
            else return 0;
        }
        else if(dp[i][state][k]!=-1) return dp[i][state][k];
        else{
            int buy=0;
            int leave=0;
            int sell=0;
            int move=0;
            if(state==0){
                buy=-prices[i]+soln(i+1,1,k,dp,prices);
                leave=soln(i+1,0,k,dp,prices);
                dp[i][state][k]=max(buy,leave);
            }
            else{
                sell=prices[i]+soln(i+1,0,k-1,dp,prices);
                move=soln(i+1,1,k,dp,prices);
                dp[i][state][k]=max(sell,move);
            }
        }
        return dp[i][state][k];
    }
    int maxProfit(int k, vector<int>& prices) {
        vector<vector<vector<int>>> dp(prices.size()+1,vector<vector<int>>(2,vector<int>(k+1,-1)));
        return soln(0,0,k,dp,prices);
    }
};
