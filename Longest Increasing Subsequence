class Solution {
public:
int solve(int i , int curr,  vector<vector<int>>&dp,vector<int> &nums){
    if(i==nums.size()) return 0;
    else if(dp[curr+1][i]!=-1) return dp[curr+1][i];
    else{
        // tkae
         int take=0;
        if(curr==-1||nums[i]>nums[curr])  take=solve(i+1,i,dp,nums)+1;
        // int take=solve(i+1,nums[i],cnt,dp,nums)+1;
        int leave=solve(i+1,curr,dp,nums);
        dp[curr+1][i]=max(take,leave);

    }
    return dp[curr+1][i];
}
    int lengthOfLIS(vector<int>& nums) {
        int n  =nums.size();
        vector<vector<int>> dp(n+1,vector<int>(n,-1));
        return solve(0,-1,dp,nums);
    }
};
