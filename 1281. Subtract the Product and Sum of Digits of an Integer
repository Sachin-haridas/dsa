class Solution {
public:
    int sum(int n){
        int res=0;
        while(n!=0){
            res+=n%10;
            n/=10;
        }
        return res;
    }
    int prod(int n){
        int res=1;
        while(n!=0){
            res*=n%10;
            n/=10;
        }
        return res;
    }
    int subtractProductAndSum(int n) {
            int s=sum(n);
            int p=prod(n);
            int ans= p-s;
            return ans;
    }
};
