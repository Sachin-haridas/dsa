class Solution {
public:
        pair<int,int> soln(int l,int r, string s){

            while(l>=0 && s[l]==s[r] && r<s.length()){
                l--;
                r++;
            }
            int res=r-l-1;

            return {l+1,res};
        }
    string longestPalindrome(string s) {
            int maxlen=INT_MIN;
            int start=0;
        for(int i=0;i<s.size();i++){
            int odd=soln(i,i,s).second;
            int oddstrt=soln(i,i,s).first;
         
            if(odd>maxlen){
                    maxlen=odd;
                    start=oddstrt;
            }
            int eve= soln(i,i+1,s).second;
            int evestrt= soln(i,i+1,s).first;
            if(eve>maxlen){
                    maxlen=eve;
                    start=evestrt;
            }
            
        }
        return s.substr(start,maxlen);
    }
};
