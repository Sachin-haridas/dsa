class Solution {
public:
    int soln(int i , int state,int fee, vector<vector<int>> &dp,vector<int>& prices ){
        if(i==prices.size()){
            if(state==1) return INT_MIN/2;
            else return 0;
        }
        else if(dp[i][state]!=-1) return dp[i][state];
        else{
            int buy=0;
            int leave=0;
            int sell=0;
            int move=0;
            if(state==0){
                buy=-prices[i]+soln(i+1,1,fee,dp,prices);
                leave=soln(i+1,0,fee,dp,prices);
                dp[i][state]=max(buy,leave);
            }
            else{
                sell=prices[i]-fee+soln(i+1,0,fee,dp,prices);
                move=soln(i+1,1,fee,dp,prices);
                dp[i][state]=max(sell,move);
            }

        }
        return dp[i][state];
    }
    int maxProfit(vector<int>& prices, int fee) {
        vector<vector<int>> dp(prices.size()+1,vector<int>(2,-1));
        return soln(0,0,fee,dp,prices);
    }
};
