class Solution {
public:
    bool isSubsequence(string s, string t) {
        int i=0;
        int j=0;
        if(s.empty()) return true;
        int count=0;
        while(j<t.size()){
           if(s[i]==t[j]) {
            count++;
            i++;
           }
          j++;

        }
        if(count==s.size()) return true;
        else return false;
    }
};
