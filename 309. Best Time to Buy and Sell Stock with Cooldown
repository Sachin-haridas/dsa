class Solution {
public:
    int soln(int i, int state, vector<vector<int>> &dp, vector<int> &prices){
        if(i>=prices.size()) return 0;
        else if(dp[i][state]!=-1) return dp[i][state];
        else{
            int buy=0;
            int leave=0;
            int sell=0;
            int move=0;
            if(state==0){
                buy=-prices[i]+soln(i+1,1,dp,prices);
                leave=soln(i+1,0,dp,prices);
                dp[i][state]=max(buy,leave);
            }
            else{
                sell=prices[i]+soln(i+2,0,dp,prices);
                move=soln(i+1,1,dp,prices);
                dp[i][state]=max(sell,move);
            }
            return dp[i][state];
        }
    }
    int maxProfit(vector<int>& prices) {
        vector<vector<int>> dp(prices.size()+1,vector<int>(2,-1));
        return soln(0,0,dp,prices);
    }
};
