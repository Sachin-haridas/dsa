class Solution {
public:
    string addBinary(string a, string b) {
        int m = a.length()-1;
        int n = b.length()-1;
        int minlen=min(m,n);
        int cnt=minlen;
            int carry=0;
            string sum="";
        while(m>=0 && n>=0){
            int med=0;
            int x= a[m]-'0';
            int y=b[n]-'0';
            if(x==1 && y==1) {
                if(carry==1){
                    sum+="1";
                }
                else{
                sum+="0";

                }
                carry=1;
             
            }
            else if(x==0 && y==0){
               if(carry==1){
                sum+="1";
               }
               else{
                sum+="0";
               }
               carry=0;
            }
            else{
                if(carry==1){
                    sum+="0";
                    carry=1;
                }
                else{
                    sum+="1";
                    carry=0;
                }
            }
          m--;
          n--;
            
        }
       while(m>=0){
        if(carry==1){
            if(a[m]-'0'==1){
                sum+="0";
                carry=1;
            }
            else{
                sum+="1";
                carry=0;
            }
        }
        else{
            sum+=a[m];
        }
        m--;
       }
       while(n>=0){
        if(carry==1){
            if(b[n]-'0'==1){
                sum+="0";
                carry=1;
            }
            else{
                sum+="1";
                carry=0;
            }
        }
        else{
            sum+=b[n];
        }
        n--;
       }
       if(carry==1) sum+="1";
       reverse(sum.begin(),sum.end());
       return sum;
    }
};
