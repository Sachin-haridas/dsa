class Solution {
public:
  vector<string> detectTimedOutServices(vector<int> timestamps, vector<string> serviceIds, int threshold) {
    vector<string> ans;
    unordered_map<string,vector<int>> mp;
    for(int i=0;i<timestamps.size();i++){
      mp[serviceIds[i]].push_back(timestamps[i]);
    }
    for(auto &entry:mp){
      vector<int> rec= entry.second;
      sort(rec.begin(),rec.end());
      for(int i=1;i<rec.size();i++){
        if(rec[i]-rec[i-1]>threshold) {ans.push_back(entry.first);
        break;
        }
      }
      
    }
    sort(ans.begin(),ans.end());
    return ans;
  }
};
