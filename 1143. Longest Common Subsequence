class Solution {
    int solve(int i , int j,vector<vector<int>> &dp , string &t1,string &t2){
        if(i==t1.size() || j==t2.size()) return 0;
        else if(dp[i][j]!=-1) return dp[i][j];
        else{
            int ans=0;
            if(t1[i]==t2[j]) ans=1+solve(i+1,j+1,dp,t1,t2);
            
            else{
                ans=max(solve(i+1,j,dp,t1,t2),solve(i,j+1,dp,t1,t2));
            }
            dp[i][j]=ans;
        }
        return dp[i][j];
    }
public:
    int longestCommonSubsequence(string text1, string text2) {
        vector<vector<int>> dp(text1.size(),vector<int>(text2.size(),-1));
        return solve(0,0,dp,text1,text2);
    }
};
