class Solution {
public:
    int soln(int i , int state, int trans, vector<vector<vector<int>>> &dp, vector<int>& prices ){
        if(trans==2 || i==prices.size()){
            if(state==1) return INT_MIN/2;
            else return 0;
        }
        else if(dp[i][state][trans]!=-1) return dp[i][state][trans];
        else{
            int buy=0;
            int leave=0;
            int sell=0;
            int move=0;
            if(state==0){
                buy=-prices[i]+soln(i+1,1,trans,dp,prices);
                leave=soln(i+1,0,trans,dp,prices);
                dp[i][state][trans]=max(buy,leave);
            }
            else {
                sell=prices[i]+soln(i+1,0,trans+1,dp,prices);
                move=soln(i+1,1,trans,dp,prices);
                dp[i][state][trans]=max(sell,move);
            }
        }
        return dp[i][state][trans];
    }
    int maxProfit(vector<int>& prices) {
        vector<vector<vector<int>>> dp(prices.size()+1,vector<vector<int>>(2,vector<int>(2,-1)));
        return soln(0,0,0,dp,prices);
    }
};
