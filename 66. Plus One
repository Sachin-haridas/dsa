class Solution {
public:
    vector<int> plusOne(vector<int>& digits) {
        int carry = 1;                               
        for (int i = digits.size() - 1; i >= 0 && carry; i--) {
            int ans = digits[i] + carry;
            digits[i] = ans % 10;
            carry = ans / 10;
        }
        if (carry) digits.insert(digits.begin(), carry); 
        return digits;
    }
};
